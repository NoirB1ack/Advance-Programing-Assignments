#include <pthread.h>
#include <stdio.h>

#define NUM_THREADS 5
#define INCREMENTS 1000000

long shared_counter = 0;
pthread_mutex_t counter_mutex; // The lock

void* increment_count(void* arg) {
    for (int i = 0; i < INCREMENTS; i++) {
        // Lock the mutex before entering the critical section
        pthread_mutex_lock(&counter_mutex);
        
        shared_counter++; 
        
        // Unlock after modification
        pthread_mutex_unlock(&counter_mutex);
    }
    return NULL;
}

int main() {
    pthread_t threads[NUM_THREADS];
    
    // Initialize the mutex
    pthread_mutex_init(&counter_mutex, NULL);

    for (int i = 0; i < NUM_THREADS; i++) {
        pthread_create(&threads[i], NULL, increment_count, NULL);
    }

    for (int i = 0; i < NUM_THREADS; i++) {
        pthread_join(threads[i], NULL);
    }

    printf("Final Counter (With Mutex): %ld\n", shared_counter);
    
    // Clean up
    pthread_mutex_destroy(&counter_mutex);

    return 0;
}
