import pytest
import os

class ScoreProcessor:
    def process_score_file(self, file_path: str) -> int:
        file = None
        try:
            # Attempt to open and read the file
            file = open(file_path, 'r')
            content = file.read().strip()
            score = int(content)
            result = score * 10
            
        except FileNotFoundError:
            print(f"Error: The file '{file_path}' was not found. Please verify the path.")
            raise  # Re-raising allows pytest.raises to catch this in the test suite
            
        except ValueError:
            print("Error: Invalid format. The file must contain only a numeric integer.")
            raise
            
        else:
            # Executes only if no exceptions were raised in the try block
            print("Data processed successfully")
            return result
            
        finally:
            # Always executes, regardless of success or failure
            print("File cleanup completed")
            if file and not file.closed:
                file.close()


# ==========================================
#               PYTEST SUITE (15 Tests)
# ==========================================

# --- SUCCESS PATHS (Valid Data) ---

def test_01_success_standard(tmp_path):
    test_file = tmp_path / "t1.txt"
    test_file.write_text("42")
    assert ScoreProcessor().process_score_file(str(test_file)) == 420

def test_02_success_zero(tmp_path):
    test_file = tmp_path / "t2.txt"
    test_file.write_text("0")
    assert ScoreProcessor().process_score_file(str(test_file)) == 0

def test_03_success_negative(tmp_path):
    test_file = tmp_path / "t3.txt"
    test_file.write_text("-5")
    assert ScoreProcessor().process_score_file(str(test_file)) == -50

def test_04_success_large_number(tmp_path):
    test_file = tmp_path / "t4.txt"
    test_file.write_text("999999")
    assert ScoreProcessor().process_score_file(str(test_file)) == 9999990

def test_05_success_with_surrounding_whitespace(tmp_path):
    test_file = tmp_path / "t5.txt"
    test_file.write_text("   \n \t 75 \n  ")
    assert ScoreProcessor().process_score_file(str(test_file)) == 750

# --- ERROR PATHS (Missing Files) ---

def test_06_missing_file_standard():
    with pytest.raises(FileNotFoundError):
        ScoreProcessor().process_score_file("non_existent_file_123.txt")

def test_07_missing_file_empty_path():
    with pytest.raises(FileNotFoundError):
        ScoreProcessor().process_score_file("")

# --- ERROR PATHS (ValueError / Invalid Data) ---

