products = [
    {"name": "Laptop", "stock": 5},
    {"name": "Mouse", "stock": 25},
    {"name": "Keyboard", "stock": 8},
    {"name": "Monitor", "stock": 12},
    {"name": "USB Cable", "stock": 3},
]

