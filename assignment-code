class Address:
    """Represents a physical address for composition."""
    def __init__(self, street, city, zip_code):
        self.street = street
        self.city = city
        self.zip_code = zip_code

    def __str__(self):
        return f"{self.street}, {self.city}, {self.zip_code}"


class Student:
    """Base Student class demonstrating composition and protected attributes."""
    def __init__(self, name, age, address):
        self.name = name
        self._age = None  # Protected attribute
        self.age = age    # Triggers the setter for validation
        self.address = address  # Composition: Student HAS-A Address
        self.courses = []       # Mutable list

    @property
    def age(self):
        return self._age

    @age.setter
    def age(self, value):
        if not isinstance(value, int) or value < 0:
            raise ValueError("Age must be a positive integer.")
        self._age = value

    def add_course(self, course_name):
        """Updates the mutable course list."""
        self.courses.append(course_name)

    def display(self):
        print(f"--- Student Record ---")
        print(f"Name: {self.name}")
        print(f"Age: {self.age}")
        print(f"Address: {self.address}")
        print(f"Courses: {', '.join(self.courses) if self.courses else 'None'}")


class ScholarshipStudent(Student):
    """Derived class demonstrating inheritance and method overriding."""
    def __init__(self, name, age, address, scholarship_amount):
        # Initialize parent attributes using super()
        super().__init__(name, age, address)
        self.scholarship_amount = scholarship_amount

    def display(self):
        # Leverage parent display logic
        super().display()
        print(f"Scholarship: ${self.scholarship_amount:,.2f}")


# --- Execution Example ---
if __name__ == "__main__":
    # 1. Create Address object
    home_addr = Address("123 Python Lane", "Codeville", "90210")

    # 2. Create a ScholarshipStudent
    student = ScholarshipStudent("Alex Smith", 20, home_addr, 5000)

    # 3. Demonstrate mutability (adding courses)
    student.add_course("Data Structures")
    student.add_course("Algorithms")

    # 4. Display results
    student.display()

