from abc import ABC, abstractmethod

class LibraryItem(ABC):
    """Base abstract class representing common structure for all items."""
    
    # Additional Feature 1: Class-level static counter
    total_items_created = 0

    def __init__(self, title, year):
        self.title = title
        self.year = year
        
        # Increment the counter every time a new item is instantiated
        LibraryItem.total_items_created += 1

    @abstractmethod
    def display_info(self):
        """Abstract method that must be implemented by all subclasses."""
        pass


class Book(LibraryItem):
    """Subclass representing a Book."""

    def __init__(self, title, year, author):
        super().__init__(title, year)
        self.author = author

    def display_info(self):
        """Method Overriding: Book's specific implementation."""
        print(f"[Book] '{self.title}' ({self.year}) - Author: {self.author}")


class DVD(LibraryItem):
    """Subclass representing a DVD."""

    # Additional Feature 2: Default argument for genre
    def __init__(self, title, year, duration, genre="Unspecified"):
        super().__init__(title, year)
        self.duration = duration
        self.genre = genre

    def display_info(self):
        """Method Overriding: DVD's specific implementation."""
        print(f"[DVD]  '{self.title}' ({self.year}) - {self.genre}, {self.duration} mins")


if __name__ == "__main__":
    print("--- Initializing Library Catalog ---")
    
    # Creating a collection of LibraryItem objects
    # Note how the second DVD omits the genre, utilizing the default argument
    catalog = [
        Book("Dune", 1965, "Frank Herbert"),
        DVD("The Matrix", 1999, 136, "Sci-Fi"),
        Book("The Hobbit", 1937, "J.R.R. Tolkien"),
        DVD("Stop Making Sense", 1984, 88) 
    ]

    print("\n--- Polymorphism in Action ---")
    # Polymorphism: Iterating through a single collection of different types.
    # The loop calls the exact same method name, but the program dynamically 
    # executes the correct overridden method based on the object's actual class.
    for item in catalog:
        item.display_info()

    print("\n--- System Statistics ---")
    print(f"Total Library Items in System: {LibraryItem.total_items_created}")
