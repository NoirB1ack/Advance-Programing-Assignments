#include <stdio.h>
#include <time.h>

void constantTime() {
    int x = 5;
    x = x * 2 + 7;
}

void linearTime(int n) {
    long long sum = 0;
    for (int i = 0; i < n; i++)
        sum += i;
}

void quadraticTime(int n) {
    long long count = 0;
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            count++;
}

int main() {

    int n;
    clock_t start, end;
    double timeTaken;

    printf("Enter value of n: ");
    scanf("%d", &n);

    
    start = clock();
    constantTime();
    end = clock();
    printf("\nConstant Time O(1): %f seconds",
           (double)(end - start) / CLOCKS_PER_SEC);

    
    start = clock();
    linearTime(n);
    end = clock();
    printf("\nLinear Time O(n): %f seconds",
           (double)(end - start) / CLOCKS_PER_SEC);

    
    start = clock();
    quadraticTime(n);
    end = clock();
    printf("\nQuadratic Time O(n^2): %f seconds\n",
           (double)(end - start) / CLOCKS_PER_SEC);

    return 0;
}
