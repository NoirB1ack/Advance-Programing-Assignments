#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void constantSpace() {
    int a = 10, b = 20, c;
    c = a + b;
}

void linearSpace(int n) {
    int *arr = (int *)malloc(n * sizeof(int));

    if (!arr) {
        printf("\nMemory allocation failed for linear space.");
        return;
    }

    for (int i = 0; i < n; i++)
        arr[i] = i;

    free(arr);
}

void quadraticSpace(int n) {
    int **matrix = (int **)malloc(n * sizeof(int *));

    if (!matrix) {
        printf("\nMemory allocation failed for quadratic space.");
        return;
    }

    for (int i = 0; i < n; i++) {
        matrix[i] = (int *)malloc(n * sizeof(int));
        if (!matrix[i]) {
            printf("\nMemory allocation failed.");
            return;
        }
    }

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            matrix[i][j] = i + j;

    for (int i = 0; i < n; i++)
        free(matrix[i]);
    free(matrix);
}

int main() {

    int n;
    clock_t start, end;

    printf("Enter value of n: ");
    scanf("%d", &n);

    // ----- O(1) Space -----
    start = clock();
    constantSpace();
    end = clock();
    printf("\nConstant Space O(1): %f seconds",
           (double)(end - start) / CLOCKS_PER_SEC);

    // ----- O(n) Space -----
    start = clock();
    linearSpace(n);
    end = clock();
    printf("\nLinear Space O(n): %f seconds",
           (double)(end - start) / CLOCKS_PER_SEC);

    // ----- O(n^2) Space -----
    start = clock();
    quadraticSpace(n);
    end = clock();
    printf("\nQuadratic Space O(n^2): %f seconds\n",
           (double)(end - start) / CLOCKS_PER_SEC);

    return 0;
}
